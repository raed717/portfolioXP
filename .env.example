# Contact form delivery (Mail app → /api/contact). Copy to .env.local and fill in.
# Without RESEND_API_KEY, messages are only logged in development and rejected (503) in production.
# On Vercel (or any dashboard), paste values WITHOUT the surrounding quotes, e.g.
#   CONTACT_FROM_EMAIL → Raed Guembri Portfolio <contact@guembri.tn>
# then redeploy: env changes only apply to new deployments.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend. The default only works for testing.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Optional override; defaults to the email in src/data/content/contact.private.json.
CONTACT_TO_EMAIL=
PAGESPEED_API_KEY=
